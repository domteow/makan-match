# Supabase project credentials (Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public origin of the deployed app, no trailing slash. Only used to build the
# absolute og:image / og:url in index.html, so link previews unfurl. Unset in
# local dev, where it falls back to http://localhost:5173.
VITE_SITE_URL=https://your-app.vercel.app
